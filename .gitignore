# --- Dependencies -----------------------------------------------------------
/node_modules
# The collector is its own npm package with its own toolchain.
collector/node_modules
collector/.wrangler
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js ----------------------------------------------------------------
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# --- Rust / Tauri -----------------------------------------------------------
/src-tauri/target/
# Generated by tauri-build at compile time from tauri.conf.json + capabilities.
/src-tauri/gen/schemas/

# --- Testing ----------------------------------------------------------------
/coverage

# --- Storybook --------------------------------------------------------------
/storybook-static/

# --- Environment & secrets --------------------------------------------------
.env*
!.env.example
*.pem
*.p12
*.keystore

# --- Claude Code -----------------------------------------------------------
# Per-machine permission grants. `launch.json` is shared; this is not.
.claude/settings.local.json
# Local tooling config for running the app under an agent's browser pane. It
# is machine-specific and arrives by accident via `git add -A`, which is how it
# got committed once and broke Prettier on main.
.claude/launch.json

# --- Editors & OS -----------------------------------------------------------
.DS_Store
Thumbs.db
# Codex's MCP server list, which points at a localhost port on one machine.
# Same accident as `.claude/launch.json` above: picked up by `git add -A` and
# carried onto a feature branch, where it had nothing to do with the change.
.codex/

# The usage dashboard's generated output. The third instance of the accident
# the two entries above describe, and the only one that mattered: `git add -A`
# carried it onto a feature branch, and it holds live data pulled from the
# collector -- activity dates, session buckets, platform -- for the installs
# that opted in, on a public repository, under a heading that calls itself a
# private operator view. Generated output does not belong in git at the best
# of times; this particular output must never reach it.
collector/.dashboard/
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
