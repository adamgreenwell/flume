# tauri-bundler's own template with one change: %u on Exec, so a desktop
# launcher passes the clicked magnet link to Flume. Without it GLib falls back
# to %f, which a magnet: URI cannot fill, and the link is dropped (#241).
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
