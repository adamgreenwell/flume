{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flume",
  "version": "1.5.0",
  "identifier": "io.github.adamgreenwell.flume",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flume",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#12100E",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 21
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000",
        "style-src": "'self' 'unsafe-inline' http://localhost:3000",
        "img-src": "'self' data: blob: http://localhost:3000 asset: http://asset.localhost",
        "font-src": "'self' data: http://localhost:3000",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A beautiful, cross-platform BitTorrent client.",
    "longDescription": "Flume is a modern BitTorrent client built on Tauri and librqbit.",
    "copyright": "Copyright \u00a9 2026 Adam Greenwell",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwNTNFNzA5NDlBREMxQjAKUldTd3dhMUpDZWRUc0RPMjZrdUlQcit2cngwcXlUeHZ6Z0dVMTBIdUZhOWpmY1NFSTEyT1Fod3IK",
      "endpoints": [
        "https://github.com/adamgreenwell/flume/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
